# TELEGRAM BOT INTEGRATION
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# ADMIN & CMS AUTHENTICATION
# ADMIN_PASSWORD has NO default: if it is empty, only one-time codes (Telegram/email) can unlock the CMS.
# Use a long random value (e.g. `openssl rand -base64 24`).
ADMIN_PASSWORD="YOUR_SECURE_ADMIN_PASSWORD"
# Secret used to sign admin sessions (set a different long random value)
SESSION_SECRET="YOUR_RANDOM_SESSION_SECRET"

# EMAIL & SMTP CONFIGURATION
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@example.com"
SMTP_PASS="YOUR_SMTP_APP_PASSWORD"
EMAIL_FROM="your-email@example.com"
EMAIL_ALERT_ADDRESS="your-alert-email@example.com"

# OPTIONAL: GitHub token (read-only, no scopes) to raise the server's GitHub API limit. Leave empty if unsure.
GITHUB_TOKEN=""

# OPTIONAL: set to "true" ONLY if the site is reached exclusively through Cloudflare (port 3300 closed to the internet).
# It makes rate limiting use the real visitor IP (CF-Connecting-IP).
TRUST_CLOUDFLARE_HEADERS="false"
